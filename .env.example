OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
FALLBACK_LLM_MODEL=mistral
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_RERANK=5

# ── v2 agentic layer ────────────────────────────────────────────────────────
# SEC requires a descriptive User-Agent with a real contact address on every
# EDGAR request. Put your own name and email here.
SEC_USER_AGENT=Your Name your.email@example.com

# XBRL fact cache (facts in filed 10-Ks do not change, so this can be long)
XBRL_CACHE_TTL_HOURS=168

# Verification
VERIFICATION_ENABLED=true

# Optional Neo4j export — the graph agent works without it
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yourpassword
